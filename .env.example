# ============================================================
# REQUIRED — the server refuses to start without these
# ============================================================

# Admin dashboard login (also the legacy 'admin' username password).
# In production the server rejects known weak values (e.g. 'yourpassword', '123').
# Use at least 12 random characters.
ADMIN_DASHBOARD_PASSWORD=CHANGE_ME_use_a_long_random_password

# Session cookie signing secret — must be >= 32 random characters in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_use_at_least_32_random_characters

# Encrypts WhatsApp session tokens, campaigns and recipient lists (AES-256-GCM).
# Must be exactly 64 hexadecimal characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# Master key for creating sessions via the API (not needed for admin dashboard).
# If unset, POST /api/v1/sessions without a dashboard session is refused (503).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MASTER_API_KEY=CHANGE_ME_use_a_long_random_key

# ============================================================
# OPTIONAL
# ============================================================
PORT=3000
MAX_SESSIONS=10
SESSION_TIMEOUT_HOURS=24
# Default webhook URL (can be overridden per session via the API)
WEBHOOK_URL=https://your-default-webhook.com/events

# Production Environment
NODE_ENV=production
# For maintenance mode (set to 'true' to enable)
MAINTENANCE_MODE=false
# Set to 'true' to force secure (HTTPS-only) session cookies; defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
